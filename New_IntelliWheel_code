//FINAL CODE AUGUST 20TH CLAUDE VERSION 7
// Smart Wheelchair with Voice and EMG Control + Obstacle Detection
// Hardware: Arduino Mega 2560 + 2x IBT-2 (BTS7960) + 2x 24V 250W DC Motors
//           HC-05 Bluetooth (Serial1) + BioAmp Candy EMG (A0, A1) + HC-SR04

// ========== CONFIGURATION ==========
#define BAUDRATE      9600
#define SAMPLE_RATE   500
#define EMG_PIN_1     A0
#define EMG_PIN_2     A1
#define BUFFER_SIZE   128

// Ultrasonic sensor pins
#define TRIG_PIN          7
#define ECHO_PIN          8
#define OBSTACLE_DISTANCE 10   // cm

// IBT-2 motor driver pins
// R_EN and L_EN are permanently tied to 5V — do NOT toggle in code
#define LEFT_RPWM   5    // Left motor  — forward
#define LEFT_LPWM   6    // Left motor  — reverse
#define RIGHT_RPWM  9    // Right motor — forward
#define RIGHT_LPWM  10   // Right motor — reverse

// IBT-2 PWM levels
const int FORWARD_PWM = 77;   // ~30% — both motors forward
const int TURN_PWM    = 51;   // ~20% — turning motor only
#define MAX_PWM     180
#define RAMP_STEP   8
#define RAMP_DELAY  10

// EMG — separate thresholds per arm
#define EMG_THRESHOLD_LEFT  40
#define EMG_THRESHOLD_RIGHT 40

// Debounce: minimum ms between two recognised flex events (per sensor)
#define EMG_DEBOUNCE_DELAY  300UL

// Double-flex detection window: both arms must flex within this period → STOP
#define DOUBLE_FLEX_WINDOW  1000UL   // ms

// ========== GLOBALS ==========
enum ControlMode { MODE_SELECTION, VOICE_CONTROL, EMG_CONTROL };
ControlMode currentMode = MODE_SELECTION;

// EMG signal processing
int  circular_buffer[BUFFER_SIZE];
int  data_index  = 0;
long emg_sum     = 0;

// EMG state
unsigned long lastEMGActionTime = 0;
bool isMoving = false;

// Obstacle state
bool obstacleDetected = false;

// Current PWM level (used for ramp tracking)
int currentPWM = 0;

// ========== SETUP ==========
void setup() {
  Serial.begin(BAUDRATE);       // USB debug
  Serial1.begin(BAUDRATE);      // HC-05 on Mega pins 18(TX1) / 19(RX1)

  // IBT-2 pins — all start at 0 (motors off)
  pinMode(LEFT_RPWM,  OUTPUT);  analogWrite(LEFT_RPWM,  0);
  pinMode(LEFT_LPWM,  OUTPUT);  analogWrite(LEFT_LPWM,  0);
  pinMode(RIGHT_RPWM, OUTPUT);  analogWrite(RIGHT_RPWM, 0);
  pinMode(RIGHT_LPWM, OUTPUT);  analogWrite(RIGHT_LPWM, 0);

  // Ultrasonic
  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);

  Robot_Stop();
  Serial1.setTimeout(200);

  // Small delay for Bluetooth to initialise
  delay(100);

  // Initialise EMG buffer
  memset(circular_buffer, 0, sizeof(circular_buffer));

  Serial.println(F("\n\n=== SYSTEM STARTED (Mega + IBT-2) ==="));
  Serial.println(F("Obstacle detection: ACTIVE (10 cm threshold)"));

  promptModeSelection();
}

// ========== MAIN LOOP ==========
void loop() {
  checkObstacle();

  switch (currentMode) {
    case MODE_SELECTION: handleModeSelection(); break;
    case VOICE_CONTROL:  handleVoiceControl();  break;
    case EMG_CONTROL:    handleEMGControl();    break;
  }
}

// ========== MOTOR HELPERS ==========

// Ramp PWM up to target on both motors simultaneously (forward polarity)
void rampTo(int target, bool forward) {
  if (target > MAX_PWM) target = MAX_PWM;
  if (target < 0)       target = 0;

  if (currentPWM < target) {
    for (int pwm = currentPWM; pwm <= target; pwm += RAMP_STEP) {
      if (forward) {
        analogWrite(LEFT_RPWM,  pwm); analogWrite(LEFT_LPWM,  0);
        analogWrite(RIGHT_RPWM, 0); analogWrite(RIGHT_LPWM, pwm);
      } else {
        analogWrite(LEFT_RPWM,  0);   analogWrite(LEFT_LPWM,  pwm);
        analogWrite(RIGHT_RPWM, pwm);   analogWrite(RIGHT_LPWM, 0);
      }
      delay(RAMP_DELAY);
    }
  } else {
    for (int pwm = currentPWM; pwm >= target; pwm -= RAMP_STEP) {
      if (forward) {
        analogWrite(LEFT_RPWM,  pwm); analogWrite(LEFT_LPWM,  0);
        analogWrite(RIGHT_RPWM, 0); analogWrite(RIGHT_LPWM, pwm);
      } else {
        analogWrite(LEFT_RPWM,  0);   analogWrite(LEFT_LPWM,  pwm);
        analogWrite(RIGHT_RPWM, pwm);   analogWrite(RIGHT_LPWM, 0);
      }
      delay(RAMP_DELAY);
    }
  }
  currentPWM = target;
}

// ========== MOTOR CONTROL FUNCTIONS ==========

void Robot_Reverse() {
  rampTo(FORWARD_PWM, true);
  Serial.println(F("Action: REVERSE"));
}

void Robot_Forward() {
  rampTo(FORWARD_PWM, false);
  Serial.println(F("Action: FORWARD"));
}

void Robot_Right() {
  // Left wheel reverse, right wheel forward → pivot left
  analogWrite(LEFT_RPWM,  0);        analogWrite(LEFT_LPWM,  TURN_PWM);
  analogWrite(RIGHT_RPWM, 0); analogWrite(RIGHT_LPWM, TURN_PWM);
  currentPWM = TURN_PWM;
  Serial.println(F("Action: LEFT"));
}

void Robot_Left() {
  // Left wheel forward, right wheel reverse → pivot right
  analogWrite(LEFT_RPWM,  TURN_PWM); analogWrite(LEFT_LPWM,  0);
  analogWrite(RIGHT_RPWM, TURN_PWM);        analogWrite(RIGHT_LPWM, 0);
  currentPWM = TURN_PWM;
  Serial.println(F("Action: RIGHT"));
}

void Robot_Stop() {
  // Ramp down to 0 then cut all outputs
  for (int pwm = currentPWM; pwm >= 0; pwm -= RAMP_STEP) {
    analogWrite(LEFT_RPWM,  pwm); analogWrite(LEFT_LPWM,  pwm);
    analogWrite(RIGHT_RPWM, pwm); analogWrite(RIGHT_LPWM, pwm);
    delay(RAMP_DELAY);
  }
  analogWrite(LEFT_RPWM,  0); analogWrite(LEFT_LPWM,  0);
  analogWrite(RIGHT_RPWM, 0); analogWrite(RIGHT_LPWM, 0);
  currentPWM = 0;
  Serial.println(F("Action: STOP"));
}

// ========== OBSTACLE DETECTION ==========
void checkObstacle() {
  if (currentMode == VOICE_CONTROL ||
     (currentMode == EMG_CONTROL && isMoving)) {

    long dist = getDistance();

    if (dist > 0 && dist <= OBSTACLE_DISTANCE) {
      if (!obstacleDetected) {
        obstacleDetected = true;
        Robot_Stop();
        Serial1.print(F("OBSTACLE DETECTED! Distance: "));
        Serial1.print(dist);
        Serial1.println(F(" cm - STOPPED"));
        Serial.print(F("OBSTACLE at "));
        Serial.print(dist);
        Serial.println(F(" cm - EMERGENCY STOP"));
        if (currentMode == EMG_CONTROL) isMoving = false;
      }
    } else {
      obstacleDetected = false;
    }
  }
}

long getDistance() {
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);
  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);

  long duration = pulseIn(ECHO_PIN, HIGH, 30000UL); // 30 ms timeout
  if (duration == 0) return -1;
  return (long)(duration * 0.0343 / 2.0);
}

// ========== MODE SELECTION ==========
void promptModeSelection() {
  const char* menu =
    "========================================\r\n"
    "  SMART WHEELCHAIR CONTROL SYSTEM\r\n"
    "========================================\r\n"
    "  1. Send 'voice' or 'v' → Voice Control\r\n"
    "  2. Send 'emg'   or 'e' → EMG Control\r\n"
    "  3. Send 'menu'  or 'm' → This menu\r\n"
    "========================================\r\n";
  Serial1.print(menu);
  Serial.print(menu);
  Serial.println(F("Waiting for input..."));
}

void handleModeSelection() {
  if (Serial1.available() > 0 || Serial.available() > 0) {
    String command;
    if (Serial1.available() > 0) {
      command = Serial1.readStringUntil('\n');
      Serial.println(F("[BT Input]"));
    } else {
      command = Serial.readStringUntil('\n');
      Serial.println(F("[Serial Input]"));
    }
    command.trim();
    command.toLowerCase();
    Serial.print(F("Command: ")); Serial.println(command);

    if (command == "voice" || command == "v") {
      currentMode = VOICE_CONTROL;
      Serial1.println(F("\n>>> VOICE CONTROL ACTIVATED <<<"));
      Serial1.println(F("Commands: left/right/forward/back/stop"));
      Serial1.println(F("Obstacle detection: ACTIVE"));
      Serial1.println(F("Send 'menu' to change mode\n"));
      Serial.println(F(">>> VOICE CONTROL ACTIVATED <<<"));
      Robot_Stop();

    } else if (command == "emg" || command == "e") {
      currentMode = EMG_CONTROL;
      Serial1.println(F("\n>>> EMG CONTROL ACTIVATED <<<"));
      Serial1.print(F("Threshold L: ")); Serial1.print(EMG_THRESHOLD_LEFT);
      Serial1.print(F("  R: "));        Serial1.println(EMG_THRESHOLD_RIGHT);
      Serial1.println(F("Muscle flex = STOP / START"));
      Serial1.println(F("Obstacle detection: ACTIVE"));
      Serial1.println(F("Send 'menu' to change mode\n"));
      Serial.println(F(">>> EMG CONTROL ACTIVATED <<<"));
      Robot_Stop();
      isMoving        = false;
      lastEMGActionTime = 0;
      data_index      = 0;
      emg_sum         = 0;
      memset(circular_buffer, 0, sizeof(circular_buffer));
      resetEMGFilter();

    } else if (command.length() > 0) {
      Serial1.print(F("Unknown: ")); Serial1.println(command);
      Serial.print(F("Unknown: "));  Serial.println(command);
      promptModeSelection();
    }
  }
}

// ========== VOICE CONTROL MODE ==========
void handleVoiceControl() {
  if (Serial1.available() > 0 || Serial.available() > 0) {
    String raw;
    if (Serial1.available() > 0) raw = Serial1.readStringUntil('\n');
    else                          raw = Serial.readStringUntil('\n');
    raw.trim();
    if (raw.length() == 0) return;
    raw.toLowerCase();

    Serial.print(F("Voice cmd: ")); Serial.println(raw);

    if (raw == "menu" || raw == "m") {
      currentMode = MODE_SELECTION;
      Robot_Stop();
      promptModeSelection();
      return;
    }

    if (raw == "left" || raw == "l") {
      Robot_Left();
      delay(500);
      Robot_Stop();
      Serial1.println(F("LEFT"));

    } else if (raw == "right" || raw == "r") {
      Robot_Right();
      delay(500);
      Robot_Stop();
      Serial1.println(F("RIGHT"));

    } else if (raw == "forward" || raw == "f" || raw == "for") {
      if (!obstacleDetected) {
        Robot_Forward();
        Serial1.println(F("FORWARD"));
      } else {
        Serial1.println(F("Cannot move - obstacle detected!"));
        Serial.println(F("Command blocked - obstacle present"));
      }

    } else if (raw == "back" || raw == "reverse" || raw == "b") {
      Robot_Reverse();
      Serial1.println(F("BACK"));

    } else if (raw == "stop" || raw == "s") {
      Robot_Stop();
      Serial1.println(F("STOP"));

    } else {
      Serial1.print(F("Unknown: ")); Serial1.println(raw);
      Serial.print(F("Unknown: "));  Serial.println(raw);
    }
  }
}

// ========== EMG CONTROL MODE ==========
void handleEMGControl() {
  // Check for mode-change command (non-blocking)
  if (Serial1.available() > 0) {
    String command = Serial1.readStringUntil('\n');
    command.trim();
    command.toLowerCase();
    if (command == "menu" || command == "m") {
      currentMode = MODE_SELECTION;
      Robot_Stop();
      isMoving = false;
      promptModeSelection();
      return;
    }
  }

  // Non-blocking timer for 500 Hz sampling
  static unsigned long past = 0;
  unsigned long present  = micros();
  unsigned long interval = present - past;
  past = present;

  static long timer = 0;
  timer -= (long)interval;

  if (timer < 0) {
    timer += 1000000L / SAMPLE_RATE;

    // Average both EMG sensors for improved signal quality
    int raw1 = analogRead(EMG_PIN_1);
    int raw2 = analogRead(EMG_PIN_2);

    float signal1    = EMGFilter((float)raw1);
    float signal2    = EMGFilter((float)raw2);
    int   envelope1  = getEnvelope((int)abs(signal1));   // left arm
    int   envelope2  = getEnvelope((int)abs(signal2));   // right arm

    bool leftFlex  = (envelope1 > EMG_THRESHOLD_LEFT);
    bool rightFlex = (envelope2 > EMG_THRESHOLD_RIGHT);

    if ((millis() - lastEMGActionTime) > EMG_DEBOUNCE_DELAY) {
      if (leftFlex || rightFlex) {
        if (isMoving) {
          Robot_Stop();
          isMoving = false;
          Serial1.print(F("EMG L:")); Serial1.print(envelope1);
          Serial1.print(F(" R:"));   Serial1.print(envelope2);
          Serial1.println(F(" -> STOP"));
          Serial.println(F("EMG STOP"));
        } else {
          if (!obstacleDetected) {
            Robot_Forward();
            isMoving = true;
            Serial1.print(F("EMG L:")); Serial1.print(envelope1);
            Serial1.print(F(" R:"));   Serial1.print(envelope2);
            Serial1.println(F(" -> START"));
            Serial.println(F("EMG START"));
          } else {
            Serial1.println(F("Cannot start - obstacle detected!"));
            Serial.println(F("EMG blocked - obstacle present"));
          }
        }
        lastEMGActionTime = millis();
      }
    }
  }
}

// ========== EMG SIGNAL PROCESSING ==========

void resetEMGFilter() {
  for (int i = 0; i < 10; i++) EMGFilter(0.0f);
}

int getEnvelope(int abs_emg) {
  emg_sum -= circular_buffer[data_index];
  emg_sum += abs_emg;
  circular_buffer[data_index] = abs_emg;
  data_index = (data_index + 1) % BUFFER_SIZE;
  return (int)((emg_sum / BUFFER_SIZE) * 2);
}

// Band-Pass Butterworth IIR digital filter
// Sampling rate: 500 Hz | Passband: 74.5 – 149.5 Hz | Order: 4 (biquad cascade)
float EMGFilter(float input) {
  float output = input;
  {
    static float z1, z2;
    float x = output - 0.05159732f*z1 - 0.36347401f*z2;
    output   = 0.01856301f*x + 0.03712602f*z1 + 0.01856301f*z2;
    z2 = z1; z1 = x;
  }
  {
    static float z1, z2;
    float x = output + 0.53945795f*z1 - 0.39764934f*z2;
    output   = x - 2.0f*z1 + z2;
    z2 = z1; z1 = x;
  }
  {
    static float z1, z2;
    float x = output - 0.47319594f*z1 - 0.70744137f*z2;
    output   = x + 2.0f*z1 + z2;
    z2 = z1; z1 = x;
  }
  {
    static float z1, z2;
    float x = output + 1.00211112f*z1 - 0.74520226f*z2;
    output   = x - 2.0f*z1 + z2;
    z2 = z1; z1 = x;
  }
  return output;
}
