// SMART WHEELCHAIR
// Arduino Mega 2560
// 2x IBT-2 / BTS7960
// 2x 24V 250W DC Motors
// HC-05 Bluetooth
// 2x BioAmp Candy EMG
// HC-SR04 Ultrasonic Sensor
// ============================================================


// ============================================================
// CONFIGURATION
// ============================================================

#define BAUDRATE      9600
#define SAMPLE_RATE   500

#define EMG_PIN_1     A0
#define EMG_PIN_2     A1
#define BUFFER_SIZE   32

// Ultrasonic
#define TRIG_PIN          7
#define ECHO_PIN          8
#define OBSTACLE_DISTANCE 10       // cm

// IBT-2 pins
// R_EN and L_EN are permanently connected to 5V

#define LEFT_RPWM   5
#define LEFT_LPWM   6

#define RIGHT_RPWM  9
#define RIGHT_LPWM  10


// ============================================================
// MOTOR SETTINGS
// ============================================================

const int FORWARD_PWM = 45;       // ~30%
const int TURN_PWM    = 30;       // ~20%

#define MAX_PWM       180

#define RAMP_STEP     8
#define RAMP_DELAY    10


// ============================================================
// EMG SETTINGS
// ============================================================

#define EMG_THRESHOLD_LEFT   90
#define EMG_THRESHOLD_RIGHT  90

// Minimum time between separate flex events
#define EMG_DEBOUNCE_DELAY   100UL

// Two flexes must occur within this time
#define DOUBLE_FLEX_WINDOW   200UL

// Maximum difference between left/right flex
// to consider them "both at once"
#define BOTH_FLEX_WINDOW      100UL


// ============================================================
// CONTROL MODE
// ============================================================

enum ControlMode {
  MODE_SELECTION,
  VOICE_CONTROL,
  EMG_CONTROL
};

ControlMode currentMode = MODE_SELECTION;


// ============================================================
// GLOBAL STATE
// ============================================================

bool isMoving = false;
bool obstacleDetected = false;

int currentPWM = 0;


// ============================================================
// EMG EVENT STATE
// ============================================================

// Current threshold states
bool previousLeftFlex  = false;
bool previousRightFlex = false;

// Last detected flex event times
unsigned long lastLeftFlexEvent  = 0;
unsigned long lastRightFlexEvent = 0;

// Pending single flex
bool leftPending  = false;
bool rightPending = false;

unsigned long leftPendingTime  = 0;
unsigned long rightPendingTime = 0;


// ============================================================
// EMG ENVELOPE BUFFERS
// ============================================================

int leftBuffer[BUFFER_SIZE];
int rightBuffer[BUFFER_SIZE];

int leftBufferIndex  = 0;
int rightBufferIndex = 0;

long leftSum  = 0;
long rightSum = 0;


// ============================================================
// EMG FILTER STATE
// ============================================================

// Each sensor has completely independent filter states.

struct FilterState {
  float z1[4];
  float z2[4];
};

FilterState leftFilterState  = {};
FilterState rightFilterState = {};


// ============================================================
// SETUP
// ============================================================

void setup() {

  // USB serial
  Serial.begin(BAUDRATE);

  // HC-05 on Mega Serial1
  // TX1 = pin 18
  // RX1 = pin 19
  Serial1.begin(BAUDRATE);


  // ----------------------------------------------------------
  // IBT-2
  // ----------------------------------------------------------

  pinMode(LEFT_RPWM, OUTPUT);
  pinMode(LEFT_LPWM, OUTPUT);

  pinMode(RIGHT_RPWM, OUTPUT);
  pinMode(RIGHT_LPWM, OUTPUT);

  analogWrite(LEFT_RPWM, 0);
  analogWrite(LEFT_LPWM, 0);
  analogWrite(RIGHT_RPWM, 0);
  analogWrite(RIGHT_LPWM, 0);


  // ----------------------------------------------------------
  // Ultrasonic
  // ----------------------------------------------------------

  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);


  // ----------------------------------------------------------
  // EMG buffers
  // ----------------------------------------------------------

  memset(leftBuffer, 0, sizeof(leftBuffer));
  memset(rightBuffer, 0, sizeof(rightBuffer));


  Robot_Stop();

  Serial1.setTimeout(200);

  delay(100);


  Serial.println(F("\n\n========================================"));
  Serial.println(F(" SMART WHEELCHAIR SYSTEM"));
  Serial.println(F(" Mega + 2x IBT-2 + 2x EMG"));
  Serial.println(F("========================================"));

  Serial.println(F("Obstacle detection: ACTIVE"));
  Serial.println(F("EMG gesture control: ACTIVE"));

  promptModeSelection();
}


// ============================================================
// MAIN LOOP
// ============================================================

void loop() {

  checkObstacle();

  switch (currentMode) {

    case MODE_SELECTION:
      handleModeSelection();
      break;

    case VOICE_CONTROL:
      handleVoiceControl();
      break;

    case EMG_CONTROL:
      handleEMGControl();
      break;
  }
}


// ============================================================
// MOTOR RAMP
// ============================================================

void rampTo(int target, bool forward) {

  if (target > MAX_PWM)
    target = MAX_PWM;

  if (target < 0)
    target = 0;


  // ----------------------------------------------------------
  // Increase PWM
  // ----------------------------------------------------------

  if (currentPWM < target) {

    for (int pwm = currentPWM;
         pwm <= target;
         pwm += RAMP_STEP) {

      if (forward) {

        // LEFT motor forward
        analogWrite(LEFT_RPWM, 0);
        analogWrite(LEFT_LPWM, pwm);

        // RIGHT motor forward
        // Right motor is physically reversed
        analogWrite(RIGHT_RPWM, pwm);
        analogWrite(RIGHT_LPWM, 0);

      } else {

        // LEFT motor reverse
        analogWrite(LEFT_RPWM, pwm);
        analogWrite(LEFT_LPWM, 0);

        // RIGHT motor reverse
        analogWrite(RIGHT_RPWM, 0);
        analogWrite(RIGHT_LPWM, pwm);
      }

      delay(RAMP_DELAY);
    }
  }


  // ----------------------------------------------------------
  // Decrease PWM
  // ----------------------------------------------------------

  else {

    for (int pwm = currentPWM;
         pwm >= target;
         pwm -= RAMP_STEP) {

      if (forward) {

        analogWrite(LEFT_RPWM, 0);
        analogWrite(LEFT_LPWM, pwm);

        analogWrite(RIGHT_RPWM, pwm);
        analogWrite(RIGHT_LPWM, 0);

      } else {

        analogWrite(LEFT_RPWM, pwm);
        analogWrite(LEFT_LPWM, 0);

        analogWrite(RIGHT_RPWM, 0);
        analogWrite(RIGHT_LPWM, pwm);
      }

      delay(RAMP_DELAY);
    }
  }

  currentPWM = target;
}


// ============================================================
// FORWARD
// ============================================================

void Robot_Forward() {

  rampTo(FORWARD_PWM, true);

  isMoving = true;

  Serial.println(F("Action: FORWARD"));
}


// ============================================================
// REVERSE
// ============================================================

void Robot_Reverse() {

  rampTo(FORWARD_PWM, false);

  isMoving = true;

  Serial.println(F("Action: REVERSE"));
}


// ============================================================
// LEFT
// ============================================================
// Left motor reverse
// Right motor forward
// ============================================================

void Robot_Left() {

  analogWrite(LEFT_RPWM, 0);
  analogWrite(LEFT_LPWM, TURN_PWM);

  analogWrite(RIGHT_RPWM, 0);
  analogWrite(RIGHT_LPWM, TURN_PWM);

  currentPWM = TURN_PWM;
  isMoving = true;

  Serial.println(F("Action: LEFT"));
}


// ============================================================
// RIGHT
// ============================================================
// Left motor forward
// Right motor reverse
// ============================================================

void Robot_Right() {

  analogWrite(LEFT_RPWM, TURN_PWM);
  analogWrite(LEFT_LPWM, 0);

  analogWrite(RIGHT_RPWM, TURN_PWM);
  analogWrite(RIGHT_LPWM, 0);

  currentPWM = TURN_PWM;
  isMoving = true;

  Serial.println(F("Action: RIGHT"));
}


// ============================================================
// STOP
// ============================================================
void Robot_Stop() {

  analogWrite(LEFT_RPWM, 0);
  analogWrite(LEFT_LPWM, 0);

  analogWrite(RIGHT_RPWM, 0);
  analogWrite(RIGHT_LPWM, 0);

  currentPWM = 0;
  isMoving = false;

  Serial.println(F("Action: STOP"));
}


// ============================================================
// OBSTACLE DETECTION
// ============================================================

void checkObstacle() {

  if (currentMode == VOICE_CONTROL ||
      (currentMode == EMG_CONTROL && isMoving)) {

    long dist = getDistance();


    if (dist > 0 && dist <= OBSTACLE_DISTANCE) {

      if (!obstacleDetected) {

        obstacleDetected = true;

        Robot_Stop();

        Serial1.print(F("OBSTACLE DETECTED! Distance: "));
        Serial1.print(dist);
        Serial1.println(F(" cm - STOPPED"));

        Serial.print(F("OBSTACLE at "));
        Serial.print(dist);
        Serial.println(F(" cm - EMERGENCY STOP"));
      }

    } else {

      obstacleDetected = false;
    }
  }
}


// ============================================================
// ULTRASONIC DISTANCE
// ============================================================

long getDistance() {

  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);

  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);

  digitalWrite(TRIG_PIN, LOW);


  long duration =
    pulseIn(ECHO_PIN, HIGH, 30000UL);


  if (duration == 0)
    return -1;


  return (long)(duration * 0.0343 / 2.0);
}


// ============================================================
// MODE MENU
// ============================================================

void promptModeSelection() {

  const char* menu =
    "========================================\r\n"
    " SMART WHEELCHAIR CONTROL SYSTEM\r\n"
    "========================================\r\n"
    " 1. Send 'voice' or 'v' -> Voice Control\r\n"
    " 2. Send 'emg'   or 'e' -> EMG Control\r\n"
    " 3. Send 'menu'  or 'm' -> This menu\r\n"
    "========================================\r\n";

  Serial1.print(menu);
  Serial.print(menu);

  Serial.println(F("Waiting for input..."));
}


// ============================================================
// MODE SELECTION
// ============================================================

void handleModeSelection() {

  if (Serial1.available() > 0 ||
      Serial.available() > 0) {

    String command;


    if (Serial1.available() > 0) {

      command = Serial1.readStringUntil('\n');

      Serial.println(F("[BT Input]"));

    } else {

      command = Serial.readStringUntil('\n');

      Serial.println(F("[Serial Input]"));
    }


    command.trim();
    command.toLowerCase();


    Serial.print(F("Command: "));
    Serial.println(command);


    // --------------------------------------------------------
    // VOICE MODE
    // --------------------------------------------------------

    if (command == "voice" || command == "v") {

      currentMode = VOICE_CONTROL;

      Serial1.println(F("\n>>> VOICE CONTROL ACTIVATED <<<"));
      Serial1.println(F("Commands: left/right/forward/back/stop"));
      Serial1.println(F("Obstacle detection: ACTIVE"));
      Serial1.println(F("Send 'menu' to change mode\n"));

      Serial.println(F(">>> VOICE CONTROL ACTIVATED <<<"));

      Robot_Stop();
    }


    // --------------------------------------------------------
    // EMG MODE
    // --------------------------------------------------------

    else if (command == "emg" || command == "e") {

      currentMode = EMG_CONTROL;

      Serial1.println(F("\n>>> EMG CONTROL ACTIVATED <<<"));

      Serial1.println(F("LEFT flex       -> LEFT"));
      Serial1.println(F("RIGHT flex      -> RIGHT"));
      Serial1.println(F("BOTH flex       -> FORWARD"));
      Serial1.println(F("LEFT x2 <200ms  -> REVERSE"));
      Serial1.println(F("RIGHT x2 <200ms -> STOP"));

      Serial1.println(F("Obstacle detection: ACTIVE"));
      Serial1.println(F("Send 'menu' to change mode\n"));

      Serial.println(F(">>> EMG CONTROL ACTIVATED <<<"));

      Robot_Stop();


      // Reset EMG gesture state
      previousLeftFlex = false;
      previousRightFlex = false;

      leftPending = false;
      rightPending = false;

      lastLeftFlexEvent = 0;
      lastRightFlexEvent = 0;
    }


    // --------------------------------------------------------
    // UNKNOWN
    // --------------------------------------------------------

    else if (command.length() > 0) {

      Serial1.print(F("Unknown: "));
      Serial1.println(command);

      Serial.print(F("Unknown: "));
      Serial.println(command);

      promptModeSelection();
    }
  }
}


// ============================================================
// VOICE CONTROL
// ============================================================

void handleVoiceControl() {

  if (Serial1.available() > 0 ||
      Serial.available() > 0) {

    String raw;


    if (Serial1.available() > 0)
      raw = Serial1.readStringUntil('\n');

    else
      raw = Serial.readStringUntil('\n');


    raw.trim();

    if (raw.length() == 0)
      return;

    raw.toLowerCase();


    Serial.print(F("Voice cmd: "));
    Serial.println(raw);


    // --------------------------------------------------------
    // MENU
    // --------------------------------------------------------

    if (raw == "menu" || raw == "m") {

      currentMode = MODE_SELECTION;

      Robot_Stop();

      promptModeSelection();

      return;
    }


    // --------------------------------------------------------
    // LEFT
    // --------------------------------------------------------

    if (raw == "left" || raw == "l") {

      if (!obstacleDetected) {

        Robot_Left();

        delay(500);

        Robot_Stop();

        Serial1.println(F("LEFT"));
      }
    }


    // --------------------------------------------------------
    // RIGHT
    // --------------------------------------------------------

    else if (raw == "right" || raw == "r") {

      if (!obstacleDetected) {

        Robot_Right();

        delay(500);

        Robot_Stop();

        Serial1.println(F("RIGHT"));
      }
    }


    // --------------------------------------------------------
    // FORWARD
    // --------------------------------------------------------

    else if (raw == "forward" ||
             raw == "f" ||
             raw == "for") {

      if (!obstacleDetected) {

        Robot_Forward();

        Serial1.println(F("FORWARD"));

      } else {

        Serial1.println(
          F("Cannot move - obstacle detected!")
        );
      }
    }


    // --------------------------------------------------------
    // REVERSE
    // --------------------------------------------------------

    else if (raw == "back" ||
             raw == "reverse" ||
             raw == "b") {

      Robot_Reverse();

      Serial1.println(F("BACK"));
    }


    // --------------------------------------------------------
    // STOP
    // --------------------------------------------------------

    else if (raw == "stop" || raw == "s") {

      Robot_Stop();

      Serial1.println(F("STOP"));
    }


    // --------------------------------------------------------
    // UNKNOWN
    // --------------------------------------------------------

    else {

      Serial1.print(F("Unknown: "));
      Serial1.println(raw);
    }
  }
}


// ============================================================
// EMG CONTROL
// ============================================================

void handleEMGControl() {

  // ----------------------------------------------------------
  // Check Bluetooth for menu
  // ----------------------------------------------------------

  if (Serial1.available() > 0) {

    String command =
      Serial1.readStringUntil('\n');

    command.trim();
    command.toLowerCase();


    if (command == "menu" ||
        command == "m") {

      currentMode = MODE_SELECTION;

      Robot_Stop();

      leftPending = false;
      rightPending = false;

      previousLeftFlex = false;
      previousRightFlex = false;

      promptModeSelection();

      return;
    }
  }


  // ----------------------------------------------------------
  // 500 Hz sampling
  // ----------------------------------------------------------

  static unsigned long previousMicros = 0;

  unsigned long currentMicros = micros();

  if (currentMicros - previousMicros <
      (1000000UL / SAMPLE_RATE)) {

    return;
  }

  previousMicros = currentMicros;


  // ----------------------------------------------------------
  // Read EMG sensors
  // ----------------------------------------------------------

  int rawLeft  = analogRead(EMG_PIN_1);
  int rawRight = analogRead(EMG_PIN_2);


  // ----------------------------------------------------------
  // Filter independently
  // ----------------------------------------------------------

  float filteredLeft =
    EMGFilterLeft((float)rawLeft);

  float filteredRight =
    EMGFilterRight((float)rawRight);


  // ----------------------------------------------------------
  // Envelope
  // ----------------------------------------------------------

  int envelopeLeft =
    getEnvelopeLeft(abs((int)filteredLeft));

  int envelopeRight =
    getEnvelopeRight(abs((int)filteredRight));


  // ----------------------------------------------------------
  // Threshold
  // ----------------------------------------------------------

  bool leftFlex =
    (envelopeLeft > EMG_THRESHOLD_LEFT);

  bool rightFlex =
    (envelopeRight > EMG_THRESHOLD_RIGHT);


  unsigned long now = millis();


  // ==========================================================
  // RISING EDGE DETECTION
  // ==========================================================

  bool newLeftFlex =
    leftFlex && !previousLeftFlex;

  bool newRightFlex =
    rightFlex && !previousRightFlex;


  // Save current states
  previousLeftFlex  = leftFlex;
  previousRightFlex = rightFlex;


// ==========================================================
// BOTH FLEX WITHIN 100 ms -> FORWARD
// ==========================================================

// Left flex occurs while right flex is already pending
if (newLeftFlex && !newRightFlex) {

  if (rightPending &&
      (now - rightPendingTime <= BOTH_FLEX_WINDOW)) {

    // BOTH detected
    leftPending = false;
    rightPending = false;

    if (!obstacleDetected) {

      Robot_Forward();

      Serial1.println(
        F("EMG: BOTH -> FORWARD")
      );

      Serial.println(
        F("EMG: BOTH -> FORWARD")
      );
    }

    lastLeftFlexEvent = now;
    lastRightFlexEvent = now;

    return;
  }
}


// Right flex occurs while left flex is already pending
if (newRightFlex && !newLeftFlex) {

  if (leftPending &&
      (now - leftPendingTime <= BOTH_FLEX_WINDOW)) {

    // BOTH detected
    leftPending = false;
    rightPending = false;

    if (!obstacleDetected) {

      Robot_Forward();

      Serial1.println(
        F("EMG: BOTH -> FORWARD")
      );

      Serial.println(
        F("EMG: BOTH -> FORWARD")
      );
    }

    lastLeftFlexEvent = now;
    lastRightFlexEvent = now;

    return;
  }
}


  // ==========================================================
// LEFT FLEX EVENT
// ==========================================================

if (newLeftFlex && !newRightFlex) {

  // ----------------------------------------------------------
  // SECOND LEFT FLEX
  // Accept any second flex within 200 ms
  // ----------------------------------------------------------

  if (leftPending &&
      (now - leftPendingTime <= DOUBLE_FLEX_WINDOW)) {

    leftPending = false;

    Robot_Reverse();

    Serial1.println(
      F("EMG: LEFT x2 -> REVERSE")
    );

    Serial.println(
      F("EMG: LEFT x2 -> REVERSE")
    );
  }

  // ----------------------------------------------------------
  // FIRST LEFT FLEX
  // ----------------------------------------------------------

  else {

    leftPending = true;
    leftPendingTime = now;
  }

  lastLeftFlexEvent = now;
}

  // ==========================================================
  // RIGHT FLEX EVENT
  // ==========================================================

if (newRightFlex && !newLeftFlex) {

  // ----------------------------------------------------------
  // SECOND RIGHT FLEX
  // Accept any second flex within 200 ms
  // ----------------------------------------------------------

  if (rightPending &&
      (now - rightPendingTime <= DOUBLE_FLEX_WINDOW)) {

    rightPending = false;

    Robot_Stop();

    Serial1.println(
      F("EMG: RIGHT x2 -> STOP")
    );

    Serial.println(
      F("EMG: RIGHT x2 -> STOP")
    );
  }

  // ----------------------------------------------------------
  // FIRST RIGHT FLEX
  // ----------------------------------------------------------

  else {

    rightPending = true;
    rightPendingTime = now;
  }

  lastRightFlexEvent = now;
}

  // ==========================================================
  // SINGLE LEFT FLEX TIMEOUT
  // ==========================================================

  if (leftPending &&
      (now - leftPendingTime >
       DOUBLE_FLEX_WINDOW)) {

    leftPending = false;

    if (!obstacleDetected) {

      Robot_Left();

      Serial1.println(
        F("EMG: LEFT -> LEFT")
      );

      Serial.println(
        F("EMG: LEFT -> LEFT")
      );
    }
  }


  // ==========================================================
  // SINGLE RIGHT FLEX TIMEOUT
  // ==========================================================

  if (rightPending &&
      (now - rightPendingTime >
       DOUBLE_FLEX_WINDOW)) {

    rightPending = false;

    if (!obstacleDetected) {

      Robot_Right();

      Serial1.println(
        F("EMG: RIGHT -> RIGHT")
      );

      Serial.println(
        F("EMG: RIGHT -> RIGHT")
      );
    }
  }
}


// ============================================================
// LEFT EMG ENVELOPE
// ============================================================

int getEnvelopeLeft(int absEMG) {

  leftSum -= leftBuffer[leftBufferIndex];

  leftSum += absEMG;

  leftBuffer[leftBufferIndex] = absEMG;

  leftBufferIndex++;

  if (leftBufferIndex >= BUFFER_SIZE)
    leftBufferIndex = 0;


  return (int)
    ((leftSum / BUFFER_SIZE) * 2);
}


// ============================================================
// RIGHT EMG ENVELOPE
// ============================================================

int getEnvelopeRight(int absEMG) {

  rightSum -= rightBuffer[rightBufferIndex];

  rightSum += absEMG;

  rightBuffer[rightBufferIndex] = absEMG;

  rightBufferIndex++;

  if (rightBufferIndex >= BUFFER_SIZE)
    rightBufferIndex = 0;


  return (int)
    ((rightSum / BUFFER_SIZE) * 2);
}


// ============================================================
// LEFT EMG FILTER
// ============================================================

float EMGFilterLeft(float input) {

  float output = input;


  // Biquad 1
  {
    float x =
      output
      - 0.05159732f *
        leftFilterState.z1[0]
      - 0.36347401f *
        leftFilterState.z2[0];

    output =
      0.01856301f * x
      + 0.03712602f *
        leftFilterState.z1[0]
      + 0.01856301f *
        leftFilterState.z2[0];

    leftFilterState.z2[0] =
      leftFilterState.z1[0];

    leftFilterState.z1[0] = x;
  }


  // Biquad 2
  {
    float x =
      output
      + 0.53945795f *
        leftFilterState.z1[1]
      - 0.39764934f *
        leftFilterState.z2[1];

    output =
      x
      - 2.0f *
        leftFilterState.z1[1]
      + leftFilterState.z2[1];

    leftFilterState.z2[1] =
      leftFilterState.z1[1];

    leftFilterState.z1[1] = x;
  }


  // Biquad 3
  {
    float x =
      output
      - 0.47319594f *
        leftFilterState.z1[2]
      - 0.70744137f *
        leftFilterState.z2[2];

    output =
      x
      + 2.0f *
        leftFilterState.z1[2]
      + leftFilterState.z2[2];

    leftFilterState.z2[2] =
      leftFilterState.z1[2];

    leftFilterState.z1[2] = x;
  }


  // Biquad 4
  {
    float x =
      output
      + 1.00211112f *
        leftFilterState.z1[3]
      - 0.74520226f *
        leftFilterState.z2[3];

    output =
      x
      - 2.0f *
        leftFilterState.z1[3]
      + leftFilterState.z2[3];

    leftFilterState.z2[3] =
      leftFilterState.z1[3];

    leftFilterState.z1[3] = x;
  }


  return output;
}


// ============================================================
// RIGHT EMG FILTER
// ============================================================

float EMGFilterRight(float input) {

  float output = input;


  // Biquad 1
  {
    float x =
      output
      - 0.05159732f *
        rightFilterState.z1[0]
      - 0.36347401f *
        rightFilterState.z2[0];

    output =
      0.01856301f * x
      + 0.03712602f *
        rightFilterState.z1[0]
      + 0.01856301f *
        rightFilterState.z2[0];

    rightFilterState.z2[0] =
      rightFilterState.z1[0];

    rightFilterState.z1[0] = x;
  }


  // Biquad 2
  {
    float x =
      output
      + 0.53945795f *
        rightFilterState.z1[1]
      - 0.39764934f *
        rightFilterState.z2[1];

    output =
      x
      - 2.0f *
        rightFilterState.z1[1]
      + rightFilterState.z2[1];

    rightFilterState.z2[1] =
      rightFilterState.z1[1];

    rightFilterState.z1[1] = x;
  }


  // Biquad 3
  {
    float x =
      output
      - 0.47319594f *
        rightFilterState.z1[2]
      - 0.70744137f *
        rightFilterState.z2[2];

    output =
      x
      + 2.0f *
        rightFilterState.z1[2]
      + rightFilterState.z2[2];

    rightFilterState.z2[2] =
      rightFilterState.z1[2];

    rightFilterState.z1[2] = x;
  }


  // Biquad 4
  {
    float x =
      output
      + 1.00211112f *
        rightFilterState.z1[3]
      - 0.74520226f *
        rightFilterState.z2[3];

    output =
      x
      - 2.0f *
        rightFilterState.z1[3]
      + rightFilterState.z2[3];

    rightFilterState.z2[3] =
      rightFilterState.z1[3];

    rightFilterState.z1[3] = x;
  }


  return output;
}
